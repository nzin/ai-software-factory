# Copy to .env (git-ignored) and fill in.
# The Makefile loads .env and exports these to `make demo` / `make up` / the binaries.

# Required: the agents (and Kodus, BYOK) call Claude.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: self-hosted Kodus for the code-reviewer agent (see scripts/kodus-setup.md).
# Leave KODUS_TEAM_KEY empty to skip Kodus review — the pipeline still completes.
KODUS_API_URL=http://host.docker.internal:3001
KODUS_TEAM_KEY=

# Optional: lets the coordinator push the work branch and open a PR when a run
# targets a github.com remote. Without it, the branch is still pushed (if the
# remote is reachable) and the run ends at pr_ready. Needs `repo` / `pull_request` scope.
GITHUB_TOKEN=

# Optional: shared secret for the GitHub PR-review webhook (POST /v1/webhooks/github).
# Must match the secret configured on the webhook. Unset = the endpoint returns 503.
# See scripts/github-webhook.md.
GITHUB_WEBHOOK_SECRET=

# Optional: default base branch for runs that don't specify one (default: main).
ASF_BASE_BRANCH=main
