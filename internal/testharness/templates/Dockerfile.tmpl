# Generated by the AI Software Factory (internal/testharness) — do not edit: it
# is rewritten on every run. The build context is ./test, so this one image
# sees every suite: component/ (the Go API suite){{if .E2E}} and e2e/ (Playwright){{end}}.
FROM {{.GoImage}} AS component
WORKDIR /src
COPY component/ ./
RUN CGO_ENABLED=0 go build -o /out/component-test .
{{if .E2E}}
# Browsers come preinstalled, locked to the exact @playwright/test version that
# e2e/package.json pins — never `playwright install` here.
FROM {{.PlaywrightImage}}
WORKDIR /e2e
COPY e2e/package.json ./
RUN npm install --no-audit --no-fund
COPY e2e/ ./
{{else}}
FROM {{.RuntimeImage}}
{{end -}}
COPY --from=component /out/component-test /usr/local/bin/component-test
COPY run.sh /usr/local/bin/run-tests
RUN chmod +x /usr/local/bin/run-tests
ENTRYPOINT ["/usr/local/bin/run-tests"]
